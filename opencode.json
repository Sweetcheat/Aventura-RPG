{
  "$schema": "https://opencode.ai/config.json",
  "model": "ninfer/swift-1.5-qwen3.8-27b",

  "plugin": [
    "@dietrichgebert/ponytail"
  ],

  "providers": {
    "ninfer": {
      "name": "NInfer - Swift 1.5 Qwen 3.8 27B",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "swift-1.5-qwen3.8-27b": {
          "name": "Swift 1.5 Qwen 3.8 27B - RTX 4090",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 240000,
            "output": 60000
          }
        }
      }
    }
  },

  "permission": {
    "websearch": "allow",
    "webfetch": "allow"
  }
}